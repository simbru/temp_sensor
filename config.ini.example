[DEFAULT]
loginterval_s = 2
outputfile = templog.db
device_name = Temperature Sensor
api_port = 5000
max_temp_delta_c = 3.0
max_humidity_delta_pct = 10.0
write_log_file = True
sensor_type = AUTO
enable_lcd_display = False

# Sensor calibration - see README.md for details
cpu_temp_factor = 2.25
temp_scale = 1.0
temp_calibration_offset = 0.0
humidity_scale = 1.0
humidity_calibration_offset = 0.0
pressure_scale = 1.0
pressure_calibration_offset = 0.0
light_scale = 1.0
light_calibration_offset = 0.0
noise_scale = 1.0
noise_calibration_offset = 0.0