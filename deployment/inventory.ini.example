# Ansible Inventory for Temperature Sensors
# Auto-generated from server/config_server.ini
#
# Usage: ansible-playbook -i deployment/inventory.ini deployment/deploy.yml
#
# This is an EXAMPLE showing what gets generated when you have production sensors.
# The actual inventory.ini is auto-generated by running:
#   python deployment/generate_ansible_inventory.py

[temperature_sensors]
pi-room-307 ansible_host=100.64.0.5 sensor_name="Room 307" sensor_port=5000
pi-perfusion-sensor ansible_host=100.64.0.6 sensor_name="Perfusion Sensor" sensor_port=5000
pi-lab-bench ansible_host=100.64.0.7 sensor_name="Lab Bench" sensor_port=5000
pi-incubator ansible_host=100.64.0.8 sensor_name="Incubator" sensor_port=5000

[temperature_sensors:vars]
ansible_user=pi
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

# Sensor metadata (from config_server.ini)
[temperature_sensors_metadata]
# Room 307: http://100.64.0.5:5000 (poll: 60s)
# Perfusion Sensor: http://100.64.0.6:5000 (poll: 1s)
# Lab Bench: http://100.64.0.7:5000 (poll: 60s)
# Incubator: http://100.64.0.8:5000 (poll: defaults)
