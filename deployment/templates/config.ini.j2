# Temperature Sensor Client Configuration
# Auto-generated by Ansible from server/config_server.ini
# Device: {{ sensor_name }}

[SENSOR]
# How often to read sensor (seconds)
loginterval_s = 10

# Output database file (SQLite)
outputfile = templog.db

# Device name (shown in API responses and dashboard)
device_name = {{ sensor_name }}

# API server port
api_port = {{ sensor_port }}

# Spike filtering: reject unrealistic temperature changes
max_temp_delta_c = 3

# Spike filtering: reject unrealistic humidity changes
max_humidity_delta_pct = 10
