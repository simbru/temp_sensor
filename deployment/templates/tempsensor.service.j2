# Systemd service for temperature sensor client
# Auto-generated by Ansible
# Device: {{ sensor_name }}

[Unit]
Description=Temperature Sensor Client - {{ sensor_name }}
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory={{ repo_path }}
ExecStart=/home/pi/.local/bin/uv run python run_client.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
