# Server Configuration for Multi-Sensor Temperature Monitoring Dashboard
#
# This file configures which Raspberry Pi sensors the dashboard server should monitor.
# Each sensor section should have a unique name and specify the sensor's API URL.

[SERVER]
# How often to poll sensors for new data (seconds)
poll_interval_s = 2

# Port for Bokeh dashboard
dashboard_port = 8000

# SQLite database path for cached sensor data
database_path = sensor_data.db

# Dashboard update interval (milliseconds)
dashboard_update_ms = 5000

[SENSORS]
# List of sensors to monitor
# Format: sensor_name = http://headscale_ip:port
#
# For local testing (simulated sensors):
Test_Sensor_1 = http://localhost:5001
Test_Sensor_2 = http://localhost:5002
Test_Sensor_3 = http://localhost:5003
#
# For production (update these with your actual Headscale IPs):
# Room_397 = http://100.64.0.5:5000
# Lab_Bench = http://100.64.0.6:5000
# Incubator = http://100.64.0.7:5000
